{
  "entities": {
    "Idea": {
      "title": "Idea",
      "description": "A saved idea with structured metadata, topic tags, key concepts, connections, and evolution tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the idea" },
        "userId": { "type": "string", "description": "UID of the owner" },
        "title": { "type": "string", "maxLength": 200, "description": "Concise title generated by Gemini or edited by user" },
        "description": { "type": "string", "maxLength": 1000, "description": "Short description of the idea" },
        "content": { "type": "string", "maxLength": 10000, "description": "Full idea content or synthesis" },
        "topicTags": { "type": "array", "description": "List of topic tags" },
        "keyConcepts": { "type": "array", "description": "Key concepts extracted by Gemini" },
        "connections": { "type": "array", "description": "List of connections to other ideas of the authenticated user" },
        "evolutionStage": { "type": "string", "description": "Evolution stage: seed, refinement, new_direction, or mature" },
        "evolvedFromIdeaId": { "type": "string", "description": "Optional ID of predecessor idea" },
        "originalConversationId": { "type": "string", "description": "Optional conversation ID from which idea was born" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "title", "description", "content", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Multi-turn conversation session with Gemini for idea exploration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the conversation" },
        "userId": { "type": "string", "description": "UID of the owner" },
        "title": { "type": "string", "maxLength": 200, "description": "Title or topic of conversation" },
        "messages": { "type": "array", "description": "Array of conversation message objects" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "title", "messages", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Basic user profile and settings bound to authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account first seen timestamp" }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document owned by the authenticated user."
    },
    "/users/{userId}/ideas/{ideaId}": {
      "schema": "Idea",
      "description": "Individual idea documents belonging strictly to the authenticated user."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Multi-turn Gemini conversation documents owned strictly by the authenticated user."
    }
  }
}
